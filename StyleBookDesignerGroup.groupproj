<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{BDDC3722-1EDD-4CDD-B4BF-AF7A7948458F}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="StyleBookDesigner.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="FormDesigner\FMXFormDesigner.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="StyleBookDesigner">
        <MSBuild Projects="StyleBookDesigner.dproj"/>
    </Target>
    <Target Name="StyleBookDesigner:Clean">
        <MSBuild Projects="StyleBookDesigner.dproj" Targets="Clean"/>
    </Target>
    <Target Name="StyleBookDesigner:Make">
        <MSBuild Projects="StyleBookDesigner.dproj" Targets="Make"/>
    </Target>
    <Target Name="FMXFormDesigner">
        <MSBuild Projects="FormDesigner\FMXFormDesigner.dproj"/>
    </Target>
    <Target Name="FMXFormDesigner:Clean">
        <MSBuild Projects="FormDesigner\FMXFormDesigner.dproj" Targets="Clean"/>
    </Target>
    <Target Name="FMXFormDesigner:Make">
        <MSBuild Projects="FormDesigner\FMXFormDesigner.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="StyleBookDesigner;FMXFormDesigner"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="StyleBookDesigner:Clean;FMXFormDesigner:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="StyleBookDesigner:Make;FMXFormDesigner:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
